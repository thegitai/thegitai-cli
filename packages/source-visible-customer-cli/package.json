{
  "name": "@thegitai/cli",
  "version": "1.0.0-preview.32",
  "description": "TheGitAI is an agentic AI coding tool for your terminal. It reads and searches your repository, writes and edits files, runs your tests, and verifies the change before handing it back.",
  "keywords": [
    "agentic-ai",
    "ai-coding-agent",
    "coding-agent",
    "ai-agent",
    "agentic-coding",
    "autonomous-agent",
    "ai-pair-programming",
    "coding-assistant",
    "code-assistant",
    "ai",
    "terminal",
    "cli",
    "developer-tools"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://thegit.ai",
  "bugs": {
    "url": "https://github.com/thegitai/thegitai-cli/issues",
    "email": "support@thegit.ai"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "./dist/bin/ai.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ./scripts/clean-dist.mjs && node ./scripts/copy-tui-binary.mjs",
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-parsers.mjs && node ./scripts/copy-vendor.mjs && node ./scripts/ensure-bin-executable.mjs dist/bin/ai.js",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0",
    "@lydell/node-pty-darwin-arm64": "1.1.0",
    "@lydell/node-pty-darwin-x64": "1.1.0",
    "@lydell/node-pty-linux-arm64": "1.1.0",
    "@lydell/node-pty-linux-x64": "1.1.0",
    "@lydell/node-pty-win32-arm64": "1.1.0",
    "@lydell/node-pty-win32-x64": "1.1.0",
    "@thegitai/tui-darwin-arm64": "1.0.0-preview.32",
    "@thegitai/tui-darwin-x64": "1.0.0-preview.32",
    "@thegitai/tui-linux-x64": "1.0.0-preview.32",
    "@thegitai/tui-win32-x64": "1.0.0-preview.32",
    "@vscode/ripgrep": "1.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "web-tree-sitter": "^0.26.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegitai/thegitai-cli.git"
  }
}
